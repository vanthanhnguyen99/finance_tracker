DATABASE_URL=postgresql://expense_user:expense_password@localhost:5432/expense_db
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=expense_password
POSTGRES_DB=expense_db
ADMIN_TOKEN=change-me
# Enable only behind a trusted proxy that overwrites X-Forwarded-For and is
# the sole ingress to the app. Otherwise rate limits use a shared client bucket.
TRUST_PROXY=false
