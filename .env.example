# Owner credentials are used only by PostgreSQL, provisioning and migrations.
DATABASE_URL=postgresql://expense_owner:replace-with-random-password@db:5432/expense_db
POSTGRES_USER=expense_owner
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=expense_db
# Generate at least 32 random bytes; only the localhost admin service receives it.
ADMIN_TOKEN=replace-with-a-random-64-character-token
# Generated by: node scripts/provision-runtime-roles.mjs
APP_DATABASE_URL=
ADMIN_DATABASE_URL=
APP_ORIGINS=https://financetracker.wt.id.vn
# Only the private app behind deploy/nginx.conf enables TRUST_PROXY.
GLASS_UI_ENABLED=false
